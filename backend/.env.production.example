# ------------------------------------------------------------------
# Hindi Typing Tutor – PRODUCTION settings
# Used by: npm run start:prod  /  npm run prod  /  npm run seed:prod
# (node server.js --production). In production ONLY this file is read.
# Never commit this file (it is in .gitignore).
# ------------------------------------------------------------------
NODE_ENV=production

# The API also serves the built frontend (frontend/dist) on this port
PORT=5000

# MongoDB connection (Atlas). Keep the password private.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hindi_typing_tutor?retryWrites=true&w=majority

# Long random secret for signing login tokens – different from development.
# Changing it logs everybody out.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d

# Public URL of the site (scheme + host [+ port]); comma-separate several
CLIENT_URL=http://localhost:5000

# Cookies are "Secure" (sent only over HTTPS; browsers also allow them on
# http://localhost). Set to false ONLY for a plain-http install on a LAN/IP.
COOKIE_SECURE=true

# Number of reverse proxies in front of the app (Nginx, Render, Heroku …)
TRUST_PROXY=1

# Logging: info | warn | error  (JSON logs in backend/logs/)
LOG_LEVEL=info

# Rate limits per 15 minutes and IP
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=1000

# Password hashing cost
BCRYPT_ROUNDS=12
